[Unit]
Description=Saar-Fighters SSH-Fernwartung im lokalen Netz
After=network.target
ConditionPathExists=/var/lib/saar-base-ready
ConditionPathExists=!/etc/saar-live
ConditionPathExists=!/etc/saar-fighters/ssh/disabled

[Service]
Type=simple
ExecStartPre=/usr/bin/sshd -t -f /etc/saar-fighters/ssh/sshd_config
ExecStart=/usr/bin/sshd -D -e -f /etc/saar-fighters/ssh/sshd_config
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=process
UMask=0077

[Install]
WantedBy=multi-user.target
